<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/bg</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/dim</item>
        <item name="android:alertDialogTheme">@style/Dialog</item>
        <item name="android:windowContentTransitions">false</item>
        <item name="android:windowActivityTransitions">false</item>
    </style>
    <style name="PlayerTheme" parent="@style/AppTheme">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
    <style name="Dialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:textColorHint">@color/dim</item>
    </style>
    <!-- testi -->
    <style name="T" />
    <style name="T.Title">
        <item name="android:textSize">@dimen/title</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="T.Body">
        <item name="android:textSize">@dimen/text_m</item>
        <item name="android:textColor">@color/muted</item>
    </style>
    <style name="T.Small">
        <item name="android:textSize">@dimen/text_s</item>
        <item name="android:textColor">@color/muted</item>
    </style>
    <!-- pulsanti -->
    <style name="Btn">
        <item name="android:layout_height">@dimen/btn_h</item>
        <item name="android:background">@drawable/bg_btn</item>
        <item name="android:textColor">@color/on_focus_text</item>
        <item name="android:textSize">@dimen/text_m</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:gravity">center</item>
        <item name="android:focusable">true</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:singleLine">true</item>
    </style>
    <style name="Btn.Primary">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">@color/on_accent</item>
    </style>
    <style name="IconBtn">
        <item name="android:layout_width">@dimen/icon_btn</item>
        <item name="android:layout_height">@dimen/icon_btn</item>
        <item name="android:background">@drawable/bg_icon_btn</item>
        <item name="android:padding">11dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:focusable">true</item>
        <item name="android:tint">@color/on_focus_text</item>
    </style>
    <style name="List">
        <item name="android:scrollbars">none</item>
        <item name="android:overScrollMode">never</item>
        <item name="android:clipToPadding">false</item>
        <item name="android:descendantFocusability">afterDescendants</item>
    </style>
    <!-- schede in alto (Home, Film, Serie…) -->
    <style name="Tab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginLeft">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:background">@drawable/bg_tab</item>
        <item name="android:textColor">@color/tab_text</item>
        <item name="android:textSize">@dimen/text_m</item>
        <item name="android:textStyle">bold</item>
        <item name="android:focusable">true</item>
        <item name="android:singleLine">true</item>
    </style>
    <style name="HeroBtn">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/btn_h</item>
        <item name="android:background">@drawable/bg_hero_btn</item>
        <item name="android:textColor">@color/hero_btn_text</item>
        <item name="android:textSize">@dimen/text_l</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">22dp</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:focusable">true</item>
        <item name="android:singleLine">true</item>
    </style>
</resources>
